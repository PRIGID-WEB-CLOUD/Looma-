{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-admin dist-landing server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts src/*/*/*.test.ts admin/*.test.ts landingpage/*.test.ts",
    "bun:check": "bun install --frozen-lockfile --dry-run",
    "bun:sync": "bun install --lockfile-only",
    "build:landing": "vite build --config vite.landing.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "deploy:landing": "npm run build:landing && npx wrangler deploy --config wrangler.landing.jsonc",
    "deploy:admin": "npm run build:admin && npx wrangler deploy --config wrangler.admin.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^2.1.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "firebase": "^13.3.0",
    "hono": "^4.13.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
