{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "looma",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/landingpage",
      "/landingpage/*",
      "/landing",
      "/landing/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "looma"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://looma.prigidcollection.workers.dev",
    "ALLOWED_ORIGINS": "https://looma.prigidcollection.workers.dev,https://looma-admin.prigidcollection.workers.dev,https://looma-landing.prigidcollection.workers.dev,https://admin.prigidcollection.workers.dev",
    "R2_BUCKET_NAME": "looma"
  },
  "observability": {
    "enabled": true
  }
}
