{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "looma-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/admin",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
