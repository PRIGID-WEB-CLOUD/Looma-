rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Global Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email is string
          && request.auth.token.email.lower() in [
            'prigidwebcloud@gmail.com',
            'prigidholdings@gmail.com',
            'pocketmoofficial@gmail.com'
          ]
        )
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHandle(handle) {
      return handle is string && handle.size() >= 2 && handle.size() <= 32 && handle.matches('^[a-zA-Z0-9_.]+$');
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'handle', 'bio', 'avatarUrl',
          'location', 'interests', 'followersCount', 'followingCount',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'handle', 'bio', 'avatarUrl',
          'location', 'interests', 'followersCount', 'followingCount',
          'onboardingCompleted', 'isVerified', 'accountType',
          'businessCategory', 'businessWebsiteUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && isValidHandle(data.handle)
        && data.bio is string && data.bio.size() <= 280
        && data.avatarUrl is string && data.avatarUrl.size() <= 250000
        && data.location is string && data.location.size() <= 80
        && data.interests is list && data.interests.size() <= 8
        && (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 40))
        && data.followersCount is int && data.followersCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.onboardingCompleted is bool
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('accountType' in data) || data.accountType in ['personal', 'business'])
        && (!('businessCategory' in data) || (data.businessCategory is string && data.businessCategory.size() <= 60))
        && (!('businessWebsiteUrl' in data) || (data.businessWebsiteUrl is string && data.businessWebsiteUrl.size() <= 200 && (data.businessWebsiteUrl.size() == 0 || data.businessWebsiteUrl.matches('^https?://.+'))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateSettings(data) {
      return data.keys().hasAll([
          'uid', 'email', 'pushEnabled', 'themePreference',
          'notifyLikes', 'notifyComments', 'notifyMessages',
          'profileVisibility', 'messagePrivacy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'pushEnabled', 'themePreference',
          'notifyLikes', 'notifyComments', 'notifyMessages',
          'profileVisibility', 'messagePrivacy', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.pushEnabled is bool
        && data.themePreference in ['light', 'dark', 'system']
        && data.notifyLikes is bool
        && data.notifyComments is bool
        && data.notifyMessages is bool
        && data.profileVisibility in ['public', 'followers']
        && data.messagePrivacy in ['everyone', 'following']
        && data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorHandle', 'authorAvatar',
          'caption', 'imageUrl', 'category', 'likesCount', 'commentsCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorType', 'businessProfileId', 'actorUid', 'attachedProductIds',
          'authorName', 'authorHandle', 'authorAvatar', 'authorVerified',
          'caption', 'imageUrl', 'videoUrl', 'audioUrl', 'linkUrl', 'mediaTitle',
          'category', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && (!('authorType' in data) || data.authorType in ['personal', 'business'])
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && (!('actorUid' in data) || isValidId(data.actorUid))
        && (!('attachedProductIds' in data) || (
          data.attachedProductIds is list
          && data.attachedProductIds.size() <= 8
          && (data.attachedProductIds.size() == 0 || isValidId(data.attachedProductIds[0]))
        ))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (isValidHandle(data.authorHandle) || isValidMarketplaceSlug(data.authorHandle))
        && data.authorAvatar is string && data.authorAvatar.size() <= 250000
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.caption is string && data.caption.size() <= 1200
        && data.imageUrl is string && data.imageUrl.size() <= 600000
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 750000))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 750000))
        && (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 1000))
        && (!('mediaTitle' in data) || (data.mediaTitle is string && data.mediaTitle.size() <= 120))
        && (
          data.caption.size() >= 1
          || data.imageUrl.size() >= 1
          || ('videoUrl' in data && data.videoUrl.size() >= 1)
          || ('audioUrl' in data && data.audioUrl.size() >= 1)
          || ('linkUrl' in data && data.linkUrl.size() >= 1)
        )
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostLike(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.createdAt is timestamp;
    }

    function isValidPostCommentLike(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.createdAt is timestamp;
    }

    function isValidPostComment(data, postId) {
      return data.keys().hasAll([
          'id', 'postId', 'authorId', 'authorName', 'authorHandle',
          'authorAvatar', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'postId', 'parentCommentId', 'authorId', 'authorType',
          'businessProfileId', 'actorUid', 'authorName', 'authorHandle',
          'authorAvatar', 'authorVerified', 'text', 'likesCount', 'edited',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.postId) && data.postId == postId
        && (!('parentCommentId' in data) || isValidId(data.parentCommentId))
        && isValidId(data.authorId)
        && (!('authorType' in data) || data.authorType in ['personal', 'business'])
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && (!('actorUid' in data) || isValidId(data.actorUid))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (isValidHandle(data.authorHandle) || isValidMarketplaceSlug(data.authorHandle))
        && data.authorAvatar is string && data.authorAvatar.size() <= 250000
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0))
        && (!('edited' in data) || data.edited is bool)
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['postId', 'createdAt'])
        && data.keys().hasOnly(['postId', 'createdAt'])
        && isValidId(data.postId)
        && data.createdAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll([
          'id', 'title', 'isGroup', 'memberIds', 'lastMessageText',
          'lastMessageSenderId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'isGroup', 'memberIds', 'adminIds', 'lastMessageText',
          'lastMessageSenderId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.isGroup is bool
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && (!('adminIds' in data) || (
          data.adminIds is list
          && data.adminIds.size() >= 1
          && data.adminIds.size() <= 10
          && isValidId(data.adminIds[0])
        ))
        && data.lastMessageText is string && data.lastMessageText.size() <= 400
        && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId) {
      return data.keys().hasAll([
          'id', 'chatId', 'senderId', 'senderName', 'senderAvatar', 'text', 'memberIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'senderId', 'senderName', 'senderAvatar', 'text', 'memberIds', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.chatId) && data.chatId == chatId
        && isValidId(data.senderId) && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && data.senderAvatar is string && data.senderAvatar.size() <= 250000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && data.createdAt is timestamp;
    }

    function isValidAppNotification(data, recipientId) {
      return data.keys().hasAll([
          'id', 'recipientId', 'actorId', 'actorName', 'actorAvatar',
          'type', 'title', 'body', 'targetPostId', 'read', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'recipientId', 'actorId', 'actorName', 'actorAvatar',
          'type', 'title', 'body', 'targetPostId', 'read', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.recipientId) && data.recipientId == recipientId
        && isValidId(data.actorId) && data.actorId == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60
        && data.actorAvatar is string && data.actorAvatar.size() <= 250000
        && data.type in ['like', 'comment', 'message', 'follow', 'system', 'mention']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 240
        && data.targetPostId is string && data.targetPostId.size() <= 128
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorHandle', 'authorAvatar',
          'imageUrl', 'caption', 'expiresAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorType', 'businessProfileId', 'actorUid',
          'authorName', 'authorHandle', 'authorAvatar', 'authorVerified',
          'imageUrl', 'caption', 'expiresAtMs', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && (!('authorType' in data) || data.authorType in ['personal', 'business'])
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && (!('actorUid' in data) || isValidId(data.actorUid))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (isValidHandle(data.authorHandle) || isValidMarketplaceSlug(data.authorHandle))
        && data.authorAvatar is string && data.authorAvatar.size() <= 250000
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.imageUrl is string && data.imageUrl.size() <= 600000
        && data.caption is string && data.caption.size() <= 280
        && data.expiresAtMs is int && data.expiresAtMs > 0
        && data.createdAt is timestamp;
    }

    function isValidFollowRelation(data, userId, targetUid) {
      return data.keys().hasAll(['followerId', 'targetUid', 'createdAt'])
        && data.keys().hasOnly(['followerId', 'targetUid', 'createdAt'])
        && isValidId(data.followerId) && data.followerId == userId
        && isValidId(data.targetUid) && data.targetUid == targetUid
        && data.createdAt is timestamp;
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['uid', 'online', 'lastSeenAtMs', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'online', 'lastSeenAtMs', 'updatedAt'])
        && isValidId(data.uid)
        && data.online is bool
        && data.lastSeenAtMs is int && data.lastSeenAtMs >= 0
        && data.updatedAt is timestamp;
    }

    function isValidCallRoom(data) {
      return data.keys().hasAll([
          'id', 'chatId', 'title', 'callerId', 'callerName', 'callerAvatar',
          'isAudioOnly', 'status', 'memberIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'title', 'callerId', 'callerName', 'callerAvatar',
          'isAudioOnly', 'status', 'memberIds', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.chatId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && isValidId(data.callerId)
        && data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 60
        && data.callerAvatar is string && data.callerAvatar.size() <= 250000
        && data.isAudioOnly is bool
        && data.status in ['ringing', 'active', 'ended']
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCallPeer(data, callId, peerUid) {
      return data.keys().hasAll([
          'callId', 'uid', 'displayName', 'avatarUrl', 'cfSessionId',
          'audioTrackName', 'videoTrackName', 'isMuted', 'isVideoOff',
          'isScreenSharing', 'state', 'memberIds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'callId', 'uid', 'displayName', 'avatarUrl', 'cfSessionId',
          'audioTrackName', 'videoTrackName', 'isMuted', 'isVideoOff',
          'isScreenSharing', 'state', 'memberIds', 'updatedAt'
        ])
        && isValidId(data.callId) && data.callId == callId
        && isValidId(data.uid) && data.uid == peerUid && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.avatarUrl is string && data.avatarUrl.size() <= 250000
        && data.cfSessionId is string && data.cfSessionId.size() <= 128
        && data.audioTrackName is string && data.audioTrackName.size() <= 64
        && data.videoTrackName is string && data.videoTrackName.size() <= 64
        && data.isMuted is bool
        && data.isVideoOff is bool
        && data.isScreenSharing is bool
        && data.state in ['joined', 'declined', 'left']
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && data.updatedAt is timestamp;
    }

    function isValidHashtag(data) {
      return data.keys().hasAll(['tag', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['tag', 'createdBy', 'createdAt'])
        && data.tag is string
        && data.tag.size() >= 1
        && data.tag.size() <= 40
        && data.tag.matches('^[a-z0-9_]+$')
        && isValidId(data.createdBy)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidChatTypingStatus(data, chatId, userId) {
      return data.keys().hasAll(['chatId', 'uid', 'isTyping', 'memberIds', 'updatedAt'])
        && data.keys().hasOnly(['chatId', 'uid', 'isTyping', 'memberIds', 'updatedAt'])
        && isValidId(data.chatId) && data.chatId == chatId
        && isValidId(data.uid) && data.uid == userId && data.uid == request.auth.uid
        && data.isTyping is bool
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && data.updatedAt is timestamp;
    }

    function isValidChatReadReceipt(data, chatId, userId) {
      return data.keys().hasAll(['chatId', 'uid', 'lastReadAtMs', 'lastReadMessageId', 'memberIds', 'updatedAt'])
        && data.keys().hasOnly(['chatId', 'uid', 'lastReadAtMs', 'lastReadMessageId', 'memberIds', 'updatedAt'])
        && isValidId(data.chatId) && data.chatId == chatId
        && isValidId(data.uid) && data.uid == userId && data.uid == request.auth.uid
        && data.lastReadAtMs is int && data.lastReadAtMs >= 0
        && data.lastReadMessageId is string && data.lastReadMessageId.size() <= 128
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 10
        && isValidId(data.memberIds[0])
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'permissions',
          'grantedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'permissions',
          'grantedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.role in ['super_admin', 'moderator', 'analyst']
        && data.permissions is list && data.permissions.size() <= 16
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 48))
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberModeration(data) {
      return data.keys().hasAll(['uid', 'status', 'reason', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'status', 'reason', 'updatedBy', 'updatedAt'])
        && isValidId(data.uid)
        && data.status in ['active', 'restricted', 'suspended']
        && data.reason is string && data.reason.size() <= 400
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidModerationReport(data) {
      return data.keys().hasAll([
          'id', 'targetType', 'targetId', 'targetAuthorUid', 'targetSummary',
          'reporterUid', 'reporterName', 'category', 'severity', 'reason',
          'status', 'resolutionAction', 'reviewedBy', 'reviewedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'targetType', 'targetId', 'targetAuthorUid', 'targetSummary',
          'reporterUid', 'reporterName', 'category', 'severity', 'reason',
          'status', 'resolutionAction', 'reviewedBy', 'reviewedAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.targetType in ['post', 'story', 'comment', 'user', 'chat', 'message']
        && isValidId(data.targetId)
        && data.targetAuthorUid is string && data.targetAuthorUid.size() <= 128
        && data.targetSummary is string && data.targetSummary.size() <= 240
        && isValidId(data.reporterUid)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 60
        && data.category in ['spam', 'harassment', 'misinformation', 'nudity', 'copyright', 'other']
        && data.severity in ['low', 'medium', 'high', 'critical']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && data.status in ['open', 'reviewing', 'resolved', 'dismissed']
        && data.resolutionAction is string && data.resolutionAction.size() <= 120
        && data.reviewedBy is string && data.reviewedBy.size() <= 128
        && data.reviewedAtMs is int && data.reviewedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModerationAppeal(data) {
      return data.keys().hasAll([
          'id', 'appellantUid', 'appellantName', 'appellantHandle',
          'reportId', 'targetId', 'reason', 'status', 'reviewerUid',
          'reviewerNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'appellantUid', 'appellantName', 'appellantHandle',
          'reportId', 'targetId', 'reason', 'status', 'reviewerUid',
          'reviewerNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.appellantUid)
        && data.appellantName is string && data.appellantName.size() >= 1 && data.appellantName.size() <= 60
        && data.appellantHandle is string && data.appellantHandle.size() <= 32
        && data.reportId is string && data.reportId.size() <= 128
        && data.targetId is string && data.targetId.size() <= 128
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 600
        && data.status in ['pending', 'approved', 'rejected']
        && data.reviewerUid is string && data.reviewerUid.size() <= 128
        && data.reviewerNote is string && data.reviewerNote.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformAnnouncement(data) {
      return data.keys().hasAll([
          'id', 'title', 'body', 'severity', 'audience', 'active',
          'authorUid', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'body', 'severity', 'audience', 'active',
          'authorUid', 'authorName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 600
        && data.severity in ['info', 'warning', 'maintenance']
        && data.audience in ['all', 'verified', 'admins']
        && data.active is bool
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminConfigDoc(data) {
      return data.keys().hasAll(['id', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'storiesEnabled', 'voiceNotesEnabled', 'callsEnabled',
          'marketplaceEnabled', 'maintenanceMode', 'registrationsOpen',
          'strictModerationQueue', 'hiddenPostIds', 'version', 'summary',
          'rulesText', 'updatedBy', 'updatedAt'
        ])
        && isValidId(data.id)
        && (!('storiesEnabled' in data) || data.storiesEnabled is bool)
        && (!('voiceNotesEnabled' in data) || data.voiceNotesEnabled is bool)
        && (!('callsEnabled' in data) || data.callsEnabled is bool)
        && (!('marketplaceEnabled' in data) || data.marketplaceEnabled is bool)
        && (!('maintenanceMode' in data) || data.maintenanceMode is bool)
        && (!('registrationsOpen' in data) || data.registrationsOpen is bool)
        && (!('strictModerationQueue' in data) || data.strictModerationQueue is bool)
        && (!('hiddenPostIds' in data) || (data.hiddenPostIds is list && data.hiddenPostIds.size() <= 500))
        && (!('version' in data) || (data.version is string && data.version.size() <= 32))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 300))
        && (!('rulesText' in data) || (data.rulesText is string && data.rulesText.size() <= 5000))
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId',
          'summary', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId',
          'summary', 'createdAtMs', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.actorUid) && data.actorUid == request.auth.uid
        && data.actorEmail is string && data.actorEmail.size() <= 200
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 64
        && data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp;
    }

    function isValidAccessInquiry(data) {
      return data.keys().hasAll([
          'id', 'fullName', 'email', 'organization', 'note',
          'status', 'reviewedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fullName', 'email', 'organization', 'note',
          'status', 'reviewedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.organization is string && data.organization.size() <= 100
        && data.note is string && data.note.size() >= 1 && data.note.size() <= 600
        && data.status in ['pending', 'approved', 'archived']
        && data.reviewedBy is string && data.reviewedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDocumentUrl(url) {
      return url is string && url.size() >= 1 && url.size() <= 1000
        && (url.matches('^https?://.*$') || url.matches('^/api/storage/.*$'));
    }

    function isValidVerificationRequest(data) {
      return data.keys().hasAll([
          'id', 'uid', 'displayName', 'handle', 'avatarUrl',
          'reason', 'links', 'status', 'reviewerUid', 'reviewerNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'targetType', 'businessProfileId', 'displayName',
          'handle', 'avatarUrl', 'reason', 'links', 'documentUrls',
          'status', 'reviewerUid', 'reviewerNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.uid)
        && (!('targetType' in data) || data.targetType in ['personal', 'business'])
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (isValidHandle(data.handle) || isValidMarketplaceSlug(data.handle))
        && data.avatarUrl is string && data.avatarUrl.size() <= 250000
        && data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 500
        && data.links is list && data.links.size() >= 1 && data.links.size() <= 2
        && data.links[0] is string && data.links[0].size() >= 8 && data.links[0].size() <= 500
        && data.links[0].matches('^https?://.*$')
        && (
          data.links.size() == 1
          || (
            data.links[1] is string
            && data.links[1].size() >= 8
            && data.links[1].size() <= 500
            && data.links[1].matches('^https?://.*$')
          )
        )
        && (!('documentUrls' in data) || (
          data.documentUrls is list
          && data.documentUrls.size() <= 5
          && (data.documentUrls.size() == 0 || isValidDocumentUrl(data.documentUrls[0]))
        ))
        && data.status in ['pending', 'under_review', 'approved', 'rejected', 'more_info_required']
        && data.reviewerUid is string && data.reviewerUid.size() <= 128
        && data.reviewerNote is string && data.reviewerNote.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostCategory(data) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.description is string && data.description.size() <= 160
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMarketplaceSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 64 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidMarketplaceStore(data) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'tagline', 'ownerUid', 'ownerHandle',
          'logoUrl', 'bannerUrl', 'category', 'currency', 'publishStatus',
          'verified', 'featured', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'tagline', 'ownerUid', 'ownerHandle',
          'logoUrl', 'bannerUrl', 'category', 'currency', 'publishStatus',
          'externalStoreId', 'businessProfileId', 'verified', 'featured', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidMarketplaceSlug(data.slug)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.tagline is string && data.tagline.size() <= 180
        && isValidId(data.ownerUid)
        && (isValidHandle(data.ownerHandle) || isValidMarketplaceSlug(data.ownerHandle))
        && data.logoUrl is string && data.logoUrl.size() <= 250000
        && data.bannerUrl is string && data.bannerUrl.size() <= 250000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8
        && data.publishStatus in ['DRAFT', 'PUBLISHED', 'SUSPENDED']
        && (!('externalStoreId' in data) || (data.externalStoreId is string && data.externalStoreId.size() <= 128))
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && data.verified is bool
        && data.featured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMarketplaceProduct(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeName', 'storeSlug', 'ownerUid',
          'title', 'description', 'category', 'priceCents', 'currency',
          'imageUrl', 'stock', 'status', 'featured', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeSlug', 'ownerUid', 'businessProfileId',
          'title', 'description', 'category', 'priceCents', 'compareAtPriceCents',
          'currency', 'imageUrl', 'stock', 'status', 'featured', 'tag',
          'location', 'condition', 'galleryUrls',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.storeId)
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80
        && isValidMarketplaceSlug(data.storeSlug)
        && isValidId(data.ownerUid)
        && (!('businessProfileId' in data) || isValidId(data.businessProfileId))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 100000000
        && (!('compareAtPriceCents' in data) || (data.compareAtPriceCents is int && data.compareAtPriceCents >= 0 && data.compareAtPriceCents <= 100000000))
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8
        && data.imageUrl is string && data.imageUrl.size() <= 600000
        && data.stock is int && data.stock >= 0 && data.stock <= 1000000
        && data.status in ['ACTIVE', 'DRAFT', 'ARCHIVED']
        && data.featured is bool
        && (!('tag' in data) || (data.tag is string && data.tag.size() <= 40))
        && (!('location' in data) || (data.location is string && data.location.size() <= 80))
        && (!('condition' in data) || data.condition in ['New', 'Used - Like New', 'Used - Good', 'Used - Fair'])
        && (!('galleryUrls' in data) || (data.galleryUrls is list && data.galleryUrls.size() <= 4 && (data.galleryUrls.size() == 0 || (data.galleryUrls[0] is string && data.galleryUrls[0].size() <= 600000))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMarketplaceOrder(data) {
      return data.keys().hasAll([
          'id', 'buyerUid', 'buyerName', 'buyerEmail', 'storeId', 'storeName', 'storeOwnerUid',
          'items', 'subtotalCents', 'shippingCents', 'totalCents', 'currency',
          'paymentMethod', 'paymentStatus', 'status', 'shippingName', 'shippingPhone',
          'shippingAddress', 'shippingCity', 'note', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buyerUid', 'buyerName', 'buyerEmail', 'storeId', 'storeName',
          'storeOwnerUid', 'storeBusinessProfileId',
          'items', 'subtotalCents', 'shippingCents', 'totalCents', 'currency',
          'paymentMethod', 'paymentStatus', 'status', 'shippingName', 'shippingPhone',
          'shippingAddress', 'shippingCity', 'note', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.buyerUid)
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80
        && data.buyerEmail is string && data.buyerEmail.size() <= 200
        && isValidId(data.storeId)
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80
        && isValidId(data.storeOwnerUid)
        && (!('storeBusinessProfileId' in data) || isValidId(data.storeBusinessProfileId))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 25
        && data.items[0] is map
        && data.subtotalCents is int && data.subtotalCents >= 0 && data.subtotalCents <= 100000000
        && data.shippingCents is int && data.shippingCents >= 0 && data.shippingCents <= 10000000
        && data.totalCents is int && data.totalCents >= 0 && data.totalCents <= 110000000
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8
        && data.paymentMethod in ['card', 'cod', 'wallet']
        && data.paymentStatus in ['pending', 'paid', 'refunded']
        && data.status in ['PENDING', 'CONFIRMED', 'SHIPPED', 'DELIVERED', 'CANCELLED']
        && data.shippingName is string && data.shippingName.size() >= 1 && data.shippingName.size() <= 80
        && data.shippingPhone is string && data.shippingPhone.size() >= 3 && data.shippingPhone.size() <= 40
        && data.shippingAddress is string && data.shippingAddress.size() >= 3 && data.shippingAddress.size() <= 240
        && data.shippingCity is string && data.shippingCity.size() >= 1 && data.shippingCity.size() <= 80
        && data.note is string && data.note.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Business Profile Validation & Membership Helpers ---
    function isBusinessMember(bpId) {
      return isVerifiedUser()
        && isValidId(bpId)
        && exists(/databases/$(database)/documents/businessMemberships/$(bpId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/businessMemberships/$(bpId + '_' + request.auth.uid)).data.status == 'ACTIVE';
    }

    function businessMemberRole(bpId) {
      return get(/databases/$(database)/documents/businessMemberships/$(bpId + '_' + request.auth.uid)).data.role;
    }

    function isBusinessOwnerOrAdmin(bpId) {
      return isBusinessMember(bpId) && businessMemberRole(bpId) in ['OWNER', 'ADMIN'];
    }

    function isBusinessOwner(bpId) {
      return isBusinessMember(bpId) && businessMemberRole(bpId) == 'OWNER';
    }

    function canPublishBusinessPost(bpId) {
      return isBusinessMember(bpId) && businessMemberRole(bpId) in ['OWNER', 'ADMIN', 'EDITOR'];
    }

    function isValidBusinessProfile(data) {
      return data.keys().hasAll([
          'id', 'slug', 'displayName', 'category', 'bio', 'logoUrl', 'bannerUrl',
          'currency', 'ownerUid', 'status', 'verified', 'followersCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'displayName', 'category', 'bio', 'logoUrl', 'bannerUrl',
          'websiteUrl', 'location', 'currency', 'ownerUid', 'commerceStoreId',
          'commerceStoreSlug', 'status', 'verified', 'followersCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidMarketplaceSlug(data.slug)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.bio is string && data.bio.size() <= 280
        && data.logoUrl is string && data.logoUrl.size() <= 250000
        && data.bannerUrl is string && data.bannerUrl.size() <= 250000
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 500))
        && (!('location' in data) || (data.location is string && data.location.size() <= 80))
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8
        && isValidId(data.ownerUid)
        && (!('commerceStoreId' in data) || (data.commerceStoreId is string && data.commerceStoreId.size() <= 128))
        && (!('commerceStoreSlug' in data) || (data.commerceStoreSlug is string && data.commerceStoreSlug.size() <= 64))
        && data.status in ['ACTIVE', 'SUSPENDED']
        && data.verified is bool
        && data.followersCount is int && data.followersCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusinessHandle(data) {
      return data.keys().hasAll(['slug', 'businessProfileId', 'ownerUid', 'createdAt'])
        && data.keys().hasOnly([
          'slug', 'businessProfileId', 'ownerUid', 'isAlias', 'targetSlug', 'createdAt', 'updatedAt'
        ])
        && isValidMarketplaceSlug(data.slug)
        && isValidId(data.businessProfileId)
        && isValidId(data.ownerUid)
        && (!('isAlias' in data) || data.isAlias is bool)
        && (!('targetSlug' in data) || isValidMarketplaceSlug(data.targetSlug))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidBusinessMembership(data) {
      return data.keys().hasAll([
          'id', 'businessProfileId', 'uid', 'role', 'status',
          'invitedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'businessProfileId', 'uid', 'role', 'status',
          'invitedByUid', 'inviteId', 'displayName', 'handle', 'avatarUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.businessProfileId)
        && isValidId(data.uid)
        && data.role in ['OWNER', 'ADMIN', 'EDITOR', 'VIEWER']
        && data.status in ['ACTIVE', 'INVITED', 'REVOKED']
        && isValidId(data.invitedByUid)
        && (!('inviteId' in data) || isValidId(data.inviteId))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 60))
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 32))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusinessInvite(data) {
      return data.keys().hasAll([
          'id', 'businessProfileId', 'businessName', 'email', 'role',
          'tokenHash', 'status', 'invitedByUid', 'createdAt', 'expiresAtMs'
        ])
        && data.keys().hasOnly([
          'id', 'businessProfileId', 'businessName', 'email', 'role',
          'tokenHash', 'status', 'invitedByUid', 'createdAt', 'expiresAtMs'
        ])
        && isValidId(data.id)
        && isValidId(data.businessProfileId)
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role in ['ADMIN', 'EDITOR', 'VIEWER']
        && data.tokenHash is string && data.tokenHash.size() >= 1 && data.tokenHash.size() <= 128
        && data.status in ['PENDING', 'ACCEPTED', 'REVOKED', 'EXPIRED']
        && isValidId(data.invitedByUid)
        && data.createdAt is timestamp
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidBusinessFollower(data, bpId, followerUid) {
      return data.keys().hasAll(['followerUid', 'businessProfileId', 'createdAt'])
        && data.keys().hasOnly(['followerUid', 'businessProfileId', 'createdAt'])
        && isValidId(data.followerUid) && data.followerUid == followerUid
        && isValidId(data.businessProfileId) && data.businessProfileId == bpId
        && data.createdAt is timestamp;
    }

    function isValidBusinessNotification(data, bpId) {
      return data.keys().hasAll([
          'id', 'businessProfileId', 'actorId', 'actorName', 'actorAvatar',
          'type', 'title', 'body', 'targetId', 'read', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'businessProfileId', 'actorId', 'actorName', 'actorAvatar',
          'type', 'title', 'body', 'targetId', 'read', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.businessProfileId) && data.businessProfileId == bpId
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.actorAvatar is string && data.actorAvatar.size() <= 250000
        && data.type in ['order', 'payment', 'follow', 'comment', 'like', 'mention', 'team', 'system']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 240
        && data.targetId is string && data.targetId.size() <= 128
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidBusinessMessagingSettings(data, bpId) {
      return data.keys().hasAll([
          'businessProfileId', 'welcomeEnabled', 'welcomeMessage',
          'awayEnabled', 'awayMessage', 'quickReplies', 'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'businessProfileId', 'welcomeEnabled', 'welcomeMessage',
          'awayEnabled', 'awayMessage', 'quickReplies', 'updatedByUid', 'updatedAt'
        ])
        && isValidId(data.businessProfileId) && data.businessProfileId == bpId
        && data.welcomeEnabled is bool
        && data.welcomeMessage is string && data.welcomeMessage.size() <= 500
        && data.awayEnabled is bool
        && data.awayMessage is string && data.awayMessage.size() <= 500
        && data.quickReplies is list && data.quickReplies.size() <= 20
        && (data.quickReplies.size() == 0 || data.quickReplies[0] is map)
        && isValidId(data.updatedByUid)
        && data.updatedAt is timestamp;
    }

    function isValidBusinessChatThread(data) {
      return data.keys().hasAll([
          'id', 'businessProfileId', 'businessName', 'businessAvatar', 'businessSlug',
          'customerUid', 'customerName', 'customerAvatar', 'customerHandle',
          'participantIds', 'status', 'labels', 'assignedUid',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderType',
          'unreadByBusiness', 'unreadByCustomer', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'businessProfileId', 'businessName', 'businessAvatar', 'businessSlug',
          'customerUid', 'customerName', 'customerAvatar', 'customerHandle',
          'participantIds', 'status', 'labels', 'assignedUid',
          'linkedProductId', 'linkedProductTitle', 'linkedProductPrice',
          'linkedProductImage', 'linkedOrderId',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderType',
          'unreadByBusiness', 'unreadByCustomer', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.businessProfileId)
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 80
        && data.businessAvatar is string && data.businessAvatar.size() <= 250000
        && isValidMarketplaceSlug(data.businessSlug)
        && isValidId(data.customerUid)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80
        && data.customerAvatar is string && data.customerAvatar.size() <= 250000
        && data.customerHandle is string && data.customerHandle.size() <= 64
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50
        && isValidId(data.participantIds[0])
        && data.status in ['open', 'pending', 'resolved']
        && data.labels is list && data.labels.size() <= 8
        && (data.labels.size() == 0 || (data.labels[0] is string && data.labels[0].size() <= 32))
        && data.assignedUid is string && data.assignedUid.size() <= 128
        && (!('linkedProductId' in data) || (data.linkedProductId is string && data.linkedProductId.size() <= 128))
        && (!('linkedProductTitle' in data) || (data.linkedProductTitle is string && data.linkedProductTitle.size() <= 120))
        && (!('linkedProductPrice' in data) || (data.linkedProductPrice is string && data.linkedProductPrice.size() <= 40))
        && (!('linkedProductImage' in data) || (data.linkedProductImage is string && data.linkedProductImage.size() <= 600000))
        && (!('linkedOrderId' in data) || (data.linkedOrderId is string && data.linkedOrderId.size() <= 128))
        && data.lastMessageText is string && data.lastMessageText.size() <= 500
        && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
        && data.lastMessageSenderType in ['customer', 'business', 'system']
        && data.unreadByBusiness is bool
        && data.unreadByCustomer is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusinessChatMessage(data, chatId) {
      return data.keys().hasAll([
          'id', 'chatId', 'businessProfileId', 'customerUid', 'senderUid',
          'senderType', 'senderName', 'senderAvatar', 'text', 'messageType',
          'participantIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'businessProfileId', 'customerUid', 'senderUid',
          'senderType', 'senderName', 'senderAvatar', 'text', 'messageType',
          'productAttachment', 'orderId', 'participantIds', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.chatId) && data.chatId == chatId
        && isValidId(data.businessProfileId)
        && isValidId(data.customerUid)
        && isValidId(data.senderUid)
        && data.senderType in ['customer', 'business', 'system']
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderAvatar is string && data.senderAvatar.size() <= 250000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.messageType in ['text', 'product', 'order', 'auto_welcome', 'auto_away']
        && (!('productAttachment' in data) || data.productAttachment is map)
        && (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128))
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50
        && isValidId(data.participantIds[0])
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId);
      allow list: if isVerifiedUser() && (resource.data.onboardingCompleted == true || isAdmin());
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (!('isVerified' in incoming()) || incoming().isVerified == false || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (
        isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().followersCount == existing().followersCount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          !incoming().diff(existing()).affectedKeys().hasAny(['isVerified'])
          || isAdmin()
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'handle', 'bio', 'avatarUrl', 'location',
          'interests', 'followingCount', 'onboardingCompleted', 'isVerified',
          'accountType', 'businessCategory', 'businessWebsiteUrl', 'updatedAt'
        ])
      ) || (
        isAdmin()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().followersCount == existing().followersCount
        && incoming().followingCount == existing().followingCount
        && incoming().onboardingCompleted == existing().onboardingCompleted
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'handle', 'bio', 'avatarUrl', 'location', 'isVerified', 'updatedAt'
        ])
      );
      allow delete: if (isVerifiedUser() && isOwner(userId) && isValidId(userId))
        || (isAdmin() && isValidId(userId) && userId != request.auth.uid);

      match /private/{docId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isVerifiedUser() && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidPrivateSettings(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidPrivateSettings(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'pushEnabled', 'themePreference',
            'notifyLikes', 'notifyComments', 'notifyMessages',
            'profileVisibility', 'messagePrivacy', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /bookmarks/{postId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(postId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(postId)
          && isValidBookmark(incoming())
          && incoming().postId == postId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(postId);
      }

      match /notifications/{notificationId} {
        allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(notificationId);
        allow list: if isVerifiedUser() && isOwner(userId) && resource.data.recipientId == request.auth.uid;
        allow create: if isVerifiedUser()
          && (isOwner(userId) || incoming().type == 'mention' || isAdmin())
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidAppNotification(incoming(), userId)
          && incoming().id == notificationId
          && incoming().createdAt == request.time;
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidAppNotification(incoming(), userId)
          && incoming().id == existing().id
          && incoming().recipientId == existing().recipientId
          && incoming().actorId == existing().actorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(notificationId);
      }

      match /following/{targetUid} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(targetUid);
        allow list: if isVerifiedUser() && resource.data.followerId == userId;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(targetUid)
          && userId != targetUid
          && isValidFollowRelation(incoming(), userId, targetUid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(targetUid);
      }

      match /followers/{followerId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(followerId);
        allow list: if isVerifiedUser() && resource.data.targetUid == userId;
        allow create: if isVerifiedUser()
          && isOwner(followerId)
          && isValidId(userId)
          && isValidId(followerId)
          && userId != followerId
          && isValidFollowRelation(incoming(), followerId, userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(followerId) && isValidId(userId) && isValidId(followerId);
      }
    }

    match /posts/{postId} {
      allow get: if isVerifiedUser() && isValidId(postId);
      allow list: if isVerifiedUser() && (resource.data.category != '' || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == postId
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            (!('authorType' in incoming()) || incoming().authorType == 'personal')
            && incoming().authorId == request.auth.uid
            && (!('actorUid' in incoming()) || incoming().actorUid == request.auth.uid)
            && !('businessProfileId' in incoming())
            && (
              !('authorVerified' in incoming())
              || incoming().authorVerified == false
              || isAdmin()
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true
            )
          )
          || (
            incoming().authorType == 'business'
            && 'businessProfileId' in incoming()
            && incoming().authorId == incoming().businessProfileId
            && incoming().actorUid == request.auth.uid
            && canPublishBusinessPost(incoming().businessProfileId)
            && get(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.status == 'ACTIVE'
            && (
              !('authorVerified' in incoming())
              || incoming().authorVerified == false
              || isAdmin()
              || get(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.verified == true
            )
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && (!('authorType' in existing()) || incoming().authorType == existing().authorType)
        && (!('businessProfileId' in existing()) || incoming().businessProfileId == existing().businessProfileId)
        && (!('actorUid' in existing()) || incoming().actorUid == existing().actorUid)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Author, Business Profile editor+, or Admin edits post content
          (
            (
              existing().authorId == request.auth.uid
              || (
                'authorType' in existing()
                && existing().authorType == 'business'
                && 'businessProfileId' in existing()
                && canPublishBusinessPost(existing().businessProfileId)
              )
              || isAdmin()
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'caption', 'imageUrl', 'videoUrl', 'audioUrl', 'linkUrl',
              'mediaTitle', 'category', 'attachedProductIds', 'updatedAt'
            ])
          )
          // Action 2: Like counter increment with atomic like subdoc creation
          || (
            incoming().likesCount == existing().likesCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
          )
          // Action 3: Like counter decrement with atomic like subdoc deletion
          || (
            incoming().likesCount == existing().likesCount - 1
            && incoming().likesCount >= 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
          )
          // Action 4: Comment counter increment
          || (
            incoming().commentsCount == existing().commentsCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
          )
          // Action 5: Comment counter decrement when deleting a comment
          || (
            existing().commentsCount >= 1
            && incoming().commentsCount == existing().commentsCount - 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(postId)
        && (
          existing().authorId == request.auth.uid
          || (
            'authorType' in existing()
            && existing().authorType == 'business'
            && 'businessProfileId' in existing()
            && canPublishBusinessPost(existing().businessProfileId)
          )
          || isAdmin()
        );

      match /likes/{userId} {
        allow get: if isVerifiedUser() && isValidId(postId) && isValidId(userId);
        allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(postId)
          && isValidId(userId)
          && isValidPostLike(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(postId) && isValidId(userId);
      }

      match /comments/{commentId} {
        allow get: if isVerifiedUser() && isValidId(postId) && isValidId(commentId);
        allow list: if isVerifiedUser() && (resource.data.postId == postId || isAdmin());
        allow create: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidPostComment(incoming(), postId)
          && incoming().id == commentId
          && (!('likesCount' in incoming()) || incoming().likesCount == 0)
          && (!('edited' in incoming()) || incoming().edited == false)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && (
            (
              (!('authorType' in incoming()) || incoming().authorType == 'personal')
              && incoming().authorId == request.auth.uid
              && (!('actorUid' in incoming()) || incoming().actorUid == request.auth.uid)
              && !('businessProfileId' in incoming())
              && (
                !('authorVerified' in incoming())
                || incoming().authorVerified == false
                || isAdmin()
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true
              )
            )
            || (
              incoming().authorType == 'business'
              && 'businessProfileId' in incoming()
              && incoming().authorId == incoming().businessProfileId
              && incoming().actorUid == request.auth.uid
              && canPublishBusinessPost(incoming().businessProfileId)
              && (
                !('authorVerified' in incoming())
                || incoming().authorVerified == false
                || isAdmin()
                || get(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.verified == true
              )
            )
          );
        allow update: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidPostComment(incoming(), postId)
          && incoming().id == existing().id
          && incoming().postId == existing().postId
          && incoming().authorId == existing().authorId
          && (!('authorType' in existing()) || incoming().authorType == existing().authorType)
          && (!('businessProfileId' in existing()) || incoming().businessProfileId == existing().businessProfileId)
          && (!('actorUid' in existing()) || incoming().actorUid == existing().actorUid)
          && incoming().createdAt == existing().createdAt
          && (
            (
              (
                existing().authorId == request.auth.uid
                || (
                  'authorType' in existing()
                  && existing().authorType == 'business'
                  && 'businessProfileId' in existing()
                  && canPublishBusinessPost(existing().businessProfileId)
                )
                || isAdmin()
              )
              && incoming().edited == true
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'edited', 'updatedAt'])
            )
            || (
              (
                (!('likesCount' in existing()) && incoming().likesCount == 1)
                || ('likesCount' in existing() && incoming().likesCount == existing().likesCount + 1)
              )
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid))
            )
            || (
              'likesCount' in existing()
              && existing().likesCount >= 1
              && incoming().likesCount == existing().likesCount - 1
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid))
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(commentId)
          && (
            existing().authorId == request.auth.uid
            || (
              'authorType' in existing()
              && existing().authorType == 'business'
              && 'businessProfileId' in existing()
              && canPublishBusinessPost(existing().businessProfileId)
            )
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
            || isAdmin()
          );

        match /likes/{userId} {
          allow get: if isVerifiedUser() && isValidId(postId) && isValidId(commentId) && isValidId(userId);
          allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
          allow create: if isVerifiedUser()
            && isOwner(userId)
            && isValidId(postId)
            && isValidId(commentId)
            && isValidId(userId)
            && isValidPostCommentLike(incoming(), userId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
          allow update: if false;
          allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(postId) && isValidId(commentId) && isValidId(userId);
        }
      }
    }

    match /{path=**}/comments/{commentId} {
      allow list: if isAdmin();
    }

    match /chats/{chatId} {
      allow get: if isVerifiedUser() && isValidId(chatId) && (request.auth.uid in existing().memberIds || isAdmin());
      allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberIds || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatThread(incoming())
        && incoming().id == chatId
        && request.auth.uid in incoming().memberIds
        && (!incoming().isGroup || (
          'adminIds' in incoming()
          && request.auth.uid in incoming().adminIds
          && incoming().memberIds.hasAll(incoming().adminIds)
        ))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatThread(incoming())
        && (request.auth.uid in existing().memberIds || isAdmin())
        && incoming().id == existing().id
        && incoming().isGroup == existing().isGroup
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Standard message preview update (membership & admins unchanged)
          (
            request.auth.uid in existing().memberIds
            && incoming().memberIds == existing().memberIds
            && !incoming().diff(existing()).affectedKeys().hasAny(['adminIds'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageSenderId', 'updatedAt'
            ])
          )
          // Action 2a: Group chat participant, admin, or title management by group admin (or legacy group without adminIds)
          || (
            request.auth.uid in existing().memberIds
            && existing().isGroup == true
            && (
              ('adminIds' in existing() && request.auth.uid in existing().adminIds)
              || !('adminIds' in existing())
            )
            && incoming().memberIds.size() >= 1
            && incoming().memberIds.size() <= 10
            && (!('adminIds' in incoming()) || incoming().memberIds.hasAll(incoming().adminIds))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberIds', 'adminIds', 'title', 'lastMessageText', 'lastMessageSenderId', 'updatedAt'
            ])
          )
          // Action 2b: Self-leave by any existing group member (only removes request.auth.uid)
          || (
            request.auth.uid in existing().memberIds
            && existing().isGroup == true
            && !(request.auth.uid in incoming().memberIds)
            && incoming().memberIds.size() == existing().memberIds.size() - 1
            && existing().memberIds.hasAll(incoming().memberIds)
            && !incoming().diff(existing()).affectedKeys().hasAny(['adminIds', 'title'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberIds', 'lastMessageText', 'lastMessageSenderId', 'updatedAt'
            ])
          )
          // Action 3: Platform administrator moderates abusive group thread metadata/membership
          || (
            isAdmin()
            && incoming().memberIds.size() >= 1
            && incoming().memberIds.size() <= 10
            && (!('adminIds' in incoming()) || incoming().memberIds.hasAll(incoming().adminIds))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'memberIds', 'adminIds', 'title', 'lastMessageText', 'lastMessageSenderId', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && request.auth.uid in existing().memberIds;
        allow list: if isVerifiedUser()
          && request.auth.uid in resource.data.memberIds;
        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId)
          && incoming().id == messageId
          && incoming().createdAt == request.time
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && incoming().memberIds == get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow update, delete: if false;
      }

      match /typing/{userId} {
        allow get: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(userId)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow list: if isVerifiedUser()
          && request.auth.uid in resource.data.memberIds;
        allow create, update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(chatId)
          && isValidId(userId)
          && isValidChatTypingStatus(incoming(), chatId, userId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && incoming().memberIds == get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(chatId)
          && isValidId(userId);
      }

      match /readReceipts/{userId} {
        allow get: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(userId)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow list: if isVerifiedUser()
          && request.auth.uid in resource.data.memberIds;
        allow create, update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(chatId)
          && isValidId(userId)
          && isValidChatReadReceipt(incoming(), chatId, userId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && incoming().memberIds == get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow delete: if false;
      }
    }

    match /stories/{storyId} {
      allow get: if isVerifiedUser() && isValidId(storyId);
      allow list: if isVerifiedUser() && (resource.data.expiresAtMs > 0 || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().id == storyId
        && incoming().expiresAtMs > request.time.toMillis()
        && incoming().expiresAtMs <= request.time.toMillis() + 90000000
        && incoming().createdAt == request.time
        && (
          (
            (!('authorType' in incoming()) || incoming().authorType == 'personal')
            && incoming().authorId == request.auth.uid
            && (!('actorUid' in incoming()) || incoming().actorUid == request.auth.uid)
            && !('businessProfileId' in incoming())
            && (
              !('authorVerified' in incoming())
              || incoming().authorVerified == false
              || isAdmin()
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true
            )
          )
          || (
            incoming().authorType == 'business'
            && 'businessProfileId' in incoming()
            && incoming().authorId == incoming().businessProfileId
            && incoming().actorUid == request.auth.uid
            && canPublishBusinessPost(incoming().businessProfileId)
            && get(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.status == 'ACTIVE'
            && (
              !('authorVerified' in incoming())
              || incoming().authorVerified == false
              || isAdmin()
              || get(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.verified == true
            )
          )
        );
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(storyId)
        && (
          existing().authorId == request.auth.uid
          || (
            'authorType' in existing()
            && existing().authorType == 'business'
            && 'businessProfileId' in existing()
            && canPublishBusinessPost(existing().businessProfileId)
          )
          || isAdmin()
        );
    }

    match /presence/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId);
      allow list: if isVerifiedUser() && (resource.data.online == true || isAdmin());
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidPresence(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidPresence(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeenAtMs', 'updatedAt']);
      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);
    }

    match /calls/{callId} {
      allow get: if isVerifiedUser() && isValidId(callId) && (request.auth.uid in existing().memberIds || isAdmin());
      allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberIds || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(callId)
        && isValidCallRoom(incoming())
        && incoming().id == callId
        && incoming().callerId == request.auth.uid
        && request.auth.uid in incoming().memberIds
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(callId)
        && isValidCallRoom(incoming())
        && (request.auth.uid in existing().memberIds || isAdmin())
        && existing().status != 'ended'
        && incoming().id == existing().id
        && incoming().chatId == existing().chatId
        && incoming().callerId == existing().callerId
        && incoming().memberIds == existing().memberIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(callId);

      match /peers/{peerUid} {
        allow get: if isVerifiedUser()
          && isValidId(callId)
          && isValidId(peerUid)
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.memberIds;
        allow list: if isVerifiedUser()
          && request.auth.uid in resource.data.memberIds;
        allow create: if isVerifiedUser()
          && isOwner(peerUid)
          && isValidId(callId)
          && isValidId(peerUid)
          && isValidCallPeer(incoming(), callId, peerUid)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/calls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.memberIds
          && incoming().memberIds == get(/databases/$(database)/documents/calls/$(callId)).data.memberIds;
        allow update: if isVerifiedUser()
          && isOwner(peerUid)
          && isValidId(callId)
          && isValidId(peerUid)
          && isValidCallPeer(incoming(), callId, peerUid)
          && incoming().callId == existing().callId
          && incoming().uid == existing().uid
          && incoming().memberIds == existing().memberIds
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'avatarUrl', 'cfSessionId',
            'audioTrackName', 'videoTrackName', 'isMuted', 'isVideoOff',
            'isScreenSharing', 'state', 'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /hashtags/{tagId} {
      allow get: if isSignedIn() && isValidId(tagId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(tagId)
        && isValidHashtag(incoming())
        && incoming().tag == tagId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(tagId);
    }

    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId);
      allow list: if isSignedIn();
      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidPostCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidPostCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // --- Platform Administration Collections ---
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == adminUid
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /userModeration/{targetUid} {
      allow get: if isVerifiedUser() && isValidId(targetUid) && (isOwner(targetUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(targetUid)
        && targetUid != request.auth.uid
        && isValidMemberModeration(incoming())
        && incoming().uid == targetUid
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(targetUid) && targetUid != request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (isAdmin() || existing().reporterUid == request.auth.uid);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.reporterUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidModerationReport(incoming())
        && incoming().id == reportId
        && incoming().reporterUid == request.auth.uid
        && incoming().status == 'open'
        && incoming().reviewedBy == ''
        && incoming().reviewedAtMs == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(reportId)
        && isValidModerationReport(incoming())
        && incoming().id == existing().id
        && incoming().reporterUid == existing().reporterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow get: if isVerifiedUser() && isValidId(appealId) && (isAdmin() || existing().appellantUid == request.auth.uid);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.appellantUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(appealId)
        && isValidModerationAppeal(incoming())
        && incoming().id == appealId
        && incoming().appellantUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().reviewerUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(appealId)
        && isValidModerationAppeal(incoming())
        && incoming().id == existing().id
        && incoming().appellantUid == existing().appellantUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get: if isVerifiedUser() && isValidId(announcementId) && (existing().active == true || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.active == true || isAdmin());
      allow create: if isAdmin()
        && isValidId(announcementId)
        && isValidPlatformAnnouncement(incoming())
        && incoming().id == announcementId
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(announcementId)
        && isValidPlatformAnnouncement(incoming())
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /adminConfig/{configId} {
      allow get: if isValidId(configId) && (
        isVerifiedUser()
        || configId in ['featureFlags', 'guidelines', 'terms', 'privacy']
      );
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidAdminConfigDoc(incoming())
        && incoming().id == configId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAdminAuditLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /accessInquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidAccessInquiry(incoming())
        && incoming().id == inquiryId
        && incoming().status == 'pending'
        && incoming().reviewedBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidAccessInquiry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    match /verificationRequests/{requestId} {
      allow get: if isVerifiedUser()
        && isValidId(requestId)
        && (
          isAdmin()
          || existing().uid == request.auth.uid
          || (
            'targetType' in existing()
            && existing().targetType == 'business'
            && 'businessProfileId' in existing()
            && isBusinessMember(existing().businessProfileId)
          )
        );
      allow list: if isAdmin()
        || (isVerifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidVerificationRequest(incoming())
        && incoming().id == requestId
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().reviewerUid == ''
        && incoming().reviewerNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          !('targetType' in incoming())
          || incoming().targetType == 'personal'
          || (
            incoming().targetType == 'business'
            && 'businessProfileId' in incoming()
            && isBusinessOwnerOrAdmin(incoming().businessProfileId)
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidVerificationRequest(incoming())
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && existing().status in ['pending', 'under_review', 'more_info_required']
            && incoming().status in ['under_review', 'approved', 'rejected', 'more_info_required']
            && incoming().reviewerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewerUid', 'reviewerNote', 'updatedAt'
            ])
          )
          || (
            (
              existing().uid == request.auth.uid
              || (
                'targetType' in existing()
                && existing().targetType == 'business'
                && 'businessProfileId' in existing()
                && isBusinessOwnerOrAdmin(existing().businessProfileId)
              )
            )
            && existing().status in ['rejected', 'more_info_required']
            && incoming().status == 'pending'
            && incoming().reviewerUid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'reason', 'links', 'documentUrls', 'status', 'reviewerUid', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // --- Marketplace & E-Commerce Collections ---
    match /marketplaceStores/{storeId} {
      allow get: if isValidId(storeId)
        && (
          existing().publishStatus == 'PUBLISHED'
          || (
            isVerifiedUser()
            && (
              existing().ownerUid == request.auth.uid
              || ('businessProfileId' in existing() && isBusinessMember(existing().businessProfileId))
              || isAdmin()
            )
          )
        );
      allow list: if resource.data.publishStatus == 'PUBLISHED'
        || (isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create: if isVerifiedUser()
        && isValidId(storeId)
        && isValidMarketplaceStore(incoming())
        && incoming().id == storeId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            (
              incoming().ownerUid == request.auth.uid
              || ('businessProfileId' in incoming() && isBusinessOwnerOrAdmin(incoming().businessProfileId))
            )
            && incoming().verified == false
            && incoming().featured == false
            && incoming().publishStatus in ['DRAFT', 'PUBLISHED']
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(storeId)
        && isValidMarketplaceStore(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            (
              existing().ownerUid == request.auth.uid
              || ('businessProfileId' in existing() && isBusinessOwnerOrAdmin(existing().businessProfileId))
            )
            && existing().publishStatus != 'SUSPENDED'
            && incoming().verified == existing().verified
            && incoming().featured == existing().featured
            && incoming().publishStatus in ['DRAFT', 'PUBLISHED']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'slug', 'name', 'tagline', 'logoUrl', 'bannerUrl',
              'category', 'currency', 'publishStatus', 'externalStoreId', 'businessProfileId', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(storeId);
    }

    match /marketplaceProducts/{productId} {
      allow get: if isValidId(productId)
        && (
          existing().status == 'ACTIVE'
          || (
            isVerifiedUser()
            && (
              existing().ownerUid == request.auth.uid
              || ('businessProfileId' in existing() && isBusinessMember(existing().businessProfileId))
              || isAdmin()
            )
          )
        );
      allow list: if resource.data.status == 'ACTIVE'
        || (isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create: if isVerifiedUser()
        && isValidId(productId)
        && isValidMarketplaceProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId))
        && (
          isAdmin()
          || (
            incoming().featured == false
            && (
              (
                incoming().ownerUid == request.auth.uid
                && get(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId)).data.ownerUid == request.auth.uid
              )
              || (
                'businessProfileId' in incoming()
                && canPublishBusinessPost(incoming().businessProfileId)
                && get(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId)).data.businessProfileId == incoming().businessProfileId
              )
            )
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(productId)
        && isValidMarketplaceProduct(incoming())
        && incoming().id == existing().id
        && incoming().storeId == existing().storeId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            (
              existing().ownerUid == request.auth.uid
              || ('businessProfileId' in existing() && canPublishBusinessPost(existing().businessProfileId))
            )
            && incoming().featured == existing().featured
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'storeName', 'storeSlug', 'businessProfileId', 'title', 'description', 'category',
              'priceCents', 'compareAtPriceCents', 'currency', 'imageUrl',
              'stock', 'status', 'tag', 'location', 'condition', 'galleryUrls', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(productId)
        && (
          existing().ownerUid == request.auth.uid
          || ('businessProfileId' in existing() && canPublishBusinessPost(existing().businessProfileId))
          || isAdmin()
        );
    }

    match /marketplaceOrders/{orderId} {
      allow get: if isVerifiedUser()
        && isValidId(orderId)
        && (
          existing().buyerUid == request.auth.uid
          || existing().storeOwnerUid == request.auth.uid
          || ('storeBusinessProfileId' in existing() && isBusinessMember(existing().storeBusinessProfileId))
          || isAdmin()
        );
      allow list: if isVerifiedUser()
        && (
          resource.data.buyerUid == request.auth.uid
          || resource.data.storeOwnerUid == request.auth.uid
          || isAdmin()
        );
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidMarketplaceOrder(incoming())
        && incoming().id == orderId
        && incoming().buyerUid == request.auth.uid
        && incoming().status == 'PENDING'
        && incoming().paymentStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId))
        && get(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId)).data.publishStatus == 'PUBLISHED'
        && incoming().storeOwnerUid == get(/databases/$(database)/documents/marketplaceStores/$(incoming().storeId)).data.ownerUid;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidMarketplaceOrder(incoming())
        && incoming().id == existing().id
        && incoming().buyerUid == existing().buyerUid
        && incoming().storeId == existing().storeId
        && incoming().storeOwnerUid == existing().storeOwnerUid
        && incoming().items == existing().items
        && incoming().subtotalCents == existing().subtotalCents
        && incoming().shippingCents == existing().shippingCents
        && incoming().totalCents == existing().totalCents
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            (
              existing().storeOwnerUid == request.auth.uid
              || ('storeBusinessProfileId' in existing() && canPublishBusinessPost(existing().storeBusinessProfileId))
            )
            && !(existing().status in ['DELIVERED', 'CANCELLED'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
          )
          || (
            existing().buyerUid == request.auth.uid
            && existing().status == 'PENDING'
            && incoming().status == 'CANCELLED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // --- Business Profile Ecosystem Collections ---
    match /businessProfiles/{bpId} {
      allow get: if isValidId(bpId)
        && (
          existing().status == 'ACTIVE'
          || (isVerifiedUser() && (isBusinessMember(bpId) || isAdmin()))
        );
      allow list: if resource.data.status == 'ACTIVE'
        || (isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create: if isVerifiedUser()
        && isValidId(bpId)
        && isValidBusinessProfile(incoming())
        && incoming().id == bpId
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'ACTIVE'
        && incoming().verified == false
        && incoming().followersCount == 0
        && !('commerceStoreId' in incoming())
        && !('commerceStoreSlug' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(bpId)
        && isValidBusinessProfile(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isBusinessOwnerOrAdmin(bpId)
            && existing().status == 'ACTIVE'
            && incoming().status == existing().status
            && incoming().verified == existing().verified
            && incoming().followersCount == existing().followersCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'slug', 'displayName', 'category', 'bio', 'logoUrl', 'bannerUrl',
              'websiteUrl', 'location', 'currency', 'commerceStoreId', 'commerceStoreSlug', 'updatedAt'
            ])
          )
          || (
            incoming().followersCount == existing().followersCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/businessProfiles/$(bpId)/followers/$(request.auth.uid))
          )
          || (
            incoming().followersCount == existing().followersCount - 1
            && incoming().followersCount >= 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && !existsAfter(/databases/$(database)/documents/businessProfiles/$(bpId)/followers/$(request.auth.uid))
          )
        );
      allow delete: if isVerifiedUser() && isValidId(bpId) && (isBusinessOwner(bpId) || isAdmin());

      match /followers/{followerUid} {
        allow get: if isVerifiedUser() && isValidId(bpId) && isValidId(followerUid);
        allow list: if isVerifiedUser() && resource.data.businessProfileId == bpId;
        allow create: if isVerifiedUser()
          && isOwner(followerUid)
          && isValidId(bpId)
          && isValidId(followerUid)
          && isValidBusinessFollower(incoming(), bpId, followerUid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isOwner(followerUid) && isValidId(bpId) && isValidId(followerUid);
      }

      match /notifications/{notificationId} {
        allow get: if isVerifiedUser() && isValidId(bpId) && isValidId(notificationId) && (isBusinessMember(bpId) || isAdmin());
        allow list: if isVerifiedUser() && (isBusinessMember(bpId) || isAdmin());
        allow create: if isVerifiedUser()
          && isValidId(bpId)
          && isValidId(notificationId)
          && isValidBusinessNotification(incoming(), bpId)
          && incoming().id == notificationId
          && incoming().actorId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(bpId)
          && isValidId(notificationId)
          && isValidBusinessNotification(incoming(), bpId)
          && (isBusinessMember(bpId) || isAdmin())
          && incoming().id == existing().id
          && incoming().businessProfileId == existing().businessProfileId
          && incoming().actorId == existing().actorId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isVerifiedUser() && isValidId(bpId) && isValidId(notificationId) && (isBusinessOwnerOrAdmin(bpId) || isAdmin());
      }
      match /messagingSettings/{docId} {
        allow get: if isVerifiedUser() && isValidId(bpId) && isValidId(docId);
        allow list: if false;
        allow create, update: if isVerifiedUser()
          && isValidId(bpId)
          && isValidId(docId)
          && docId == 'config'
          && isValidBusinessMessagingSettings(incoming(), bpId)
          && (isBusinessOwnerOrAdmin(bpId) || canPublishBusinessPost(bpId) || isAdmin())
          && incoming().updatedByUid == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /businessHandles/{slug} {
      allow get: if isValidMarketplaceSlug(slug);
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidMarketplaceSlug(slug)
        && isValidBusinessHandle(incoming())
        && incoming().slug == slug
        && incoming().ownerUid == request.auth.uid
        && (!('isAlias' in incoming()) || incoming().isAlias == false)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId))
        && getAfter(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.ownerUid == request.auth.uid;
      allow update: if isVerifiedUser()
        && isValidMarketplaceSlug(slug)
        && isValidBusinessHandle(incoming())
        && (isBusinessOwnerOrAdmin(existing().businessProfileId) || isAdmin())
        && incoming().slug == existing().slug
        && incoming().businessProfileId == existing().businessProfileId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isAlias', 'targetSlug', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidMarketplaceSlug(slug)
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /businessMemberships/{membershipId} {
      allow get: if isVerifiedUser()
        && isValidId(membershipId)
        && (existing().uid == request.auth.uid || isBusinessOwnerOrAdmin(existing().businessProfileId) || isAdmin());
      allow list: if isVerifiedUser()
        && (resource.data.uid == request.auth.uid || isBusinessOwnerOrAdmin(resource.data.businessProfileId) || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(membershipId)
        && isValidBusinessMembership(incoming())
        && incoming().id == membershipId
        && membershipId == incoming().businessProfileId + '_' + incoming().uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().uid == request.auth.uid
            && incoming().role == 'OWNER'
            && incoming().status == 'ACTIVE'
            && incoming().invitedByUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId))
            && getAfter(/databases/$(database)/documents/businessProfiles/$(incoming().businessProfileId)).data.ownerUid == request.auth.uid
          )
          || (
            isBusinessOwnerOrAdmin(incoming().businessProfileId)
            && incoming().role != 'OWNER'
            && incoming().invitedByUid == request.auth.uid
          )
          || (
            'inviteId' in incoming()
            && request.auth.token.email is string
            && incoming().uid == request.auth.uid
            && incoming().role != 'OWNER'
            && incoming().status == 'ACTIVE'
            && exists(/databases/$(database)/documents/businessInvites/$(incoming().inviteId))
            && get(/databases/$(database)/documents/businessInvites/$(incoming().inviteId)).data.businessProfileId == incoming().businessProfileId
            && get(/databases/$(database)/documents/businessInvites/$(incoming().inviteId)).data.email == request.auth.token.email.lower()
            && get(/databases/$(database)/documents/businessInvites/$(incoming().inviteId)).data.role == incoming().role
            && get(/databases/$(database)/documents/businessInvites/$(incoming().inviteId)).data.status == 'PENDING'
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(membershipId)
        && isValidBusinessMembership(incoming())
        && incoming().id == existing().id
        && incoming().businessProfileId == existing().businessProfileId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isBusinessOwnerOrAdmin(existing().businessProfileId)
            && existing().role != 'OWNER'
            && incoming().role != 'OWNER'
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(membershipId)
        && (
          isAdmin()
          || (
            existing().role != 'OWNER'
            && (existing().uid == request.auth.uid || isBusinessOwnerOrAdmin(existing().businessProfileId))
          )
        );
    }

    match /businessInvites/{inviteId} {
      allow get: if isVerifiedUser()
        && isValidId(inviteId)
        && (
          isBusinessOwnerOrAdmin(existing().businessProfileId)
          || (request.auth.token.email is string && existing().email == request.auth.token.email.lower())
          || isAdmin()
        );
      allow list: if isVerifiedUser()
        && (
          isBusinessOwnerOrAdmin(resource.data.businessProfileId)
          || (request.auth.token.email is string && resource.data.email == request.auth.token.email.lower())
          || isAdmin()
        );
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidBusinessInvite(incoming())
        && incoming().id == inviteId
        && incoming().invitedByUid == request.auth.uid
        && incoming().status == 'PENDING'
        && isBusinessOwnerOrAdmin(incoming().businessProfileId)
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidBusinessInvite(incoming())
        && incoming().id == existing().id
        && incoming().businessProfileId == existing().businessProfileId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && (
          isBusinessOwnerOrAdmin(existing().businessProfileId)
          || (
            request.auth.token.email is string
            && existing().email == request.auth.token.email.lower()
            && existing().status == 'PENDING'
            && incoming().status == 'ACCEPTED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
          || isAdmin()
        );
      allow delete: if isVerifiedUser()
        && isValidId(inviteId)
        && (isBusinessOwnerOrAdmin(existing().businessProfileId) || isAdmin());
    }

    // --- Independent Business Customer Messaging Collections ---
    match /businessChats/{chatId} {
      allow get: if isVerifiedUser()
        && isValidId(chatId)
        && (
          existing().customerUid == request.auth.uid
          || request.auth.uid in existing().participantIds
          || isBusinessMember(existing().businessProfileId)
          || isAdmin()
        );
      allow list: if isVerifiedUser()
        && (
          resource.data.customerUid == request.auth.uid
          || request.auth.uid in resource.data.participantIds
          || isAdmin()
        );
      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidBusinessChatThread(incoming())
        && incoming().id == chatId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().customerUid in incoming().participantIds
        && (
          incoming().customerUid == request.auth.uid
          || canPublishBusinessPost(incoming().businessProfileId)
          || isAdmin()
        );
      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && isValidBusinessChatThread(incoming())
        && incoming().id == existing().id
        && incoming().businessProfileId == existing().businessProfileId
        && incoming().customerUid == existing().customerUid
        && incoming().customerUid in incoming().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().customerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderType',
              'unreadByBusiness', 'unreadByCustomer', 'participantIds',
              'linkedProductId', 'linkedProductTitle', 'linkedProductPrice',
              'linkedProductImage', 'linkedOrderId', 'updatedAt'
            ])
          )
          || (
            canPublishBusinessPost(existing().businessProfileId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'labels', 'assignedUid', 'participantIds',
              'linkedProductId', 'linkedProductTitle', 'linkedProductPrice',
              'linkedProductImage', 'linkedOrderId',
              'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderType',
              'unreadByBusiness', 'unreadByCustomer', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && (
            existing().customerUid == request.auth.uid
            || request.auth.uid in existing().participantIds
            || isBusinessMember(existing().businessProfileId)
            || isAdmin()
          );
        allow list: if isVerifiedUser()
          && (
            resource.data.customerUid == request.auth.uid
            || request.auth.uid in resource.data.participantIds
            || isAdmin()
          );
        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidBusinessChatMessage(incoming(), chatId)
          && incoming().id == messageId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/businessChats/$(chatId))
          && incoming().businessProfileId == get(/databases/$(database)/documents/businessChats/$(chatId)).data.businessProfileId
          && incoming().customerUid == get(/databases/$(database)/documents/businessChats/$(chatId)).data.customerUid
          && (
            (
              incoming().senderType == 'customer'
              && incoming().senderUid == request.auth.uid
              && incoming().customerUid == request.auth.uid
            )
            || (
              incoming().senderType == 'business'
              && incoming().senderUid == request.auth.uid
              && (canPublishBusinessPost(incoming().businessProfileId) || isAdmin())
            )
            || (
              incoming().senderType == 'system'
              && incoming().senderUid == request.auth.uid
              && (
                incoming().customerUid == request.auth.uid
                || canPublishBusinessPost(incoming().businessProfileId)
                || isAdmin()
              )
            )
          );
        allow update, delete: if false;
      }
    }
  }
}
