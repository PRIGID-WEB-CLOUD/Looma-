# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure as a server secret in Cloudflare Workers / runtime environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_APP_URL / APP_URL: Canonical origin URL where Looma is hosted (used for CORS & links).
APP_URL="MY_APP_URL"
PUBLIC_APP_URL="https://looma.prigidcollection.workers.dev"

# ALLOWED_ORIGINS: Comma-separated list of trusted origins allowed to call /api/*
ALLOWED_ORIGINS="https://looma.prigidcollection.workers.dev,http://localhost:3000"

# Cloudflare R2 Object Storage Credentials (local Node dev fallback / presigning; production Worker uses native R2_BUCKET binding)
R2_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="MY_CLOUDFLARE_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_CLOUDFLARE_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="looma"
R2_PUBLIC_URL="MY_CLOUDFLARE_R2_PUBLIC_DOMAIN"

# Cloudflare Calls / RealtimeKit WebRTC Credentials (set via `wrangler secret put` in production)
CLOUDFLARE_CALLS_APP_ID="MY_CLOUDFLARE_CALLS_APP_ID"
CLOUDFLARE_CALLS_APP_TOKEN="MY_CLOUDFLARE_CALLS_APP_TOKEN"

# Optional HMAC secret used to bind Cloudflare Calls session IDs to authenticated Firebase UIDs
CALLS_STATE_SECRET="MY_CALLS_STATE_SECRET"

# Optional TURN server configuration for restrictive NAT traversal (comma-separated URLs)
TURN_URLS="MY_TURN_URLS"
TURN_USERNAME="MY_TURN_USERNAME"
TURN_CREDENTIAL="MY_TURN_CREDENTIAL"
