# Server & Origin Configuration
PORT=3000
PUBLIC_APP_URL=
ALLOWED_ORIGINS=

# Cloudflare Calls SFU & Ephemeral TURN (Audio/Video Calling)
CLOUDFLARE_CALLS_APP_ID=
CLOUDFLARE_CALLS_APP_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=
CALLS_STATE_SECRET=

# Cloudflare R2 S3 Credentials (only needed for local Node dev or /api/storage/presign;
# Cloudflare Workers production uses the native R2_BUCKET binding in wrangler.jsonc)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Firebase config (projectId, apiKey, firestoreDatabaseId) is read from firebase-applet-config.json.