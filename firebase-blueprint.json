        },
        "commentsCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "authorName",
        "authorHandle",
        "authorAvatar",
        "caption",
        "imageUrl",
        "category",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
