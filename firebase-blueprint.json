        "reviewedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "targetType", "targetId", "targetAuthorUid", "targetSummary",
        "reporterUid", "reporterName", "category", "severity", "reason",
        "status", "resolutionAction", "reviewedBy", "reviewedAtMs", "createdAt", "updatedAt"
      ]
    },
    "ModerationAppeal": {
      "title": "ModerationAppeal",
      "description": "Member appeal requesting review of a restriction, suspension, or content removal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "appellantUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appellantName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "appellantHandle": { "type": "string", "maxLength": 32 },
        "reportId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewerUid": { "type": "string", "maxLength": 128 },
        "reviewerNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "appellantUid", "appellantName", "appellantHandle",
        "reportId", "targetId", "reason", "status", "reviewerUid",
        "reviewerNote", "createdAt", "updatedAt"
      ]
    },
    "PlatformAnnouncement": {
      "title": "PlatformAnnouncement",
      "description": "Broadcast announcement or maintenance notice published by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 600 },
        "severity": { "type": "string", "enum": ["info", "warning", "maintenance"] },
        "audience": { "type": "string", "enum": ["all", "verified", "admins"] },
        "active": { "type": "boolean" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "title", "body", "severity", "audience", "active",
        "authorUid", "authorName", "createdAt", "updatedAt"
      ]
    },
    "AdminConfigDoc": {
      "title": "AdminConfigDoc",
      "description": "Platform configuration document storing feature flags, moderation lists, community guidelines, terms, and privacy policies.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storiesEnabled": { "type": "boolean" },
        "voiceNotesEnabled": { "type": "boolean" },
        "callsEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "registrationsOpen": { "type": "boolean" },
        "strictModerationQueue": { "type": "boolean" },
        "hiddenPostIds": { "type": "array", "description": "Hidden post document IDs" },
        "version": { "type": "string", "maxLength": 32 },
        "summary": { "type": "string", "maxLength": 300 },
        "rulesText": { "type": "string", "maxLength": 5000 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "updatedBy", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable append-only audit log entry recording administrative actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetType": { "type": "string", "minLength": 1, "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "targetType", "targetId", "summary", "createdAtMs", "createdAt"]
    },
    "AccessInquiryRecord": {
      "title": "AccessInquiryRecord",
      "description": "Workspace access inquiry submitted for administrator approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "organization": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "minLength": 1, "maxLength": 600 },
        "status": { "type": "string", "enum": ["pending", "approved", "archived"] },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "organization", "note", "status", "reviewedBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public profile documents keyed by UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateSettings" },
      "description": "Private PII and notification/theme preferences accessible only to owner."
    },
    "/users/{userId}/bookmarks/{postId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "Private user post bookmarks."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Real-time notifications scoped to recipient user."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Social media feed posts."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Per-user like document for a post."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments belonging to a post."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Chat threads restricted to memberIds."
    },
    "/users/{userId}/following/{targetUid}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Users followed by userId."
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Users who follow userId."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour homefeed stories."
    },
    "/presence/{userId}": {
      "schema": { "$ref": "#/entities/UserPresence" },
      "description": "Online presence status keyed by UID."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat thread."
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/ChatTypingStatus" },
      "description": "Per-member real-time typing indicator state inside a chat thread."
    },
    "/chats/{chatId}/readReceipts/{userId}": {
      "schema": { "$ref": "#/entities/ChatReadReceipt" },
      "description": "Per-member read receipt watermark inside a chat thread."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallRoom" },
      "description": "Real-time audio/video call rooms scoped to memberIds."
    },
    "/calls/{callId}/peers/{peerUid}": {
      "schema": { "$ref": "#/entities/CallPeerSession" },
      "description": "Participant Cloudflare Calls SFU session & track names within a call."
    },
    "/hashtags/{tagId}": {
      "schema": { "$ref": "#/entities/Hashtag" },
      "description": "Community hashtags saved automatically when created."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRoleRecord" },
      "description": "Authorized platform administrator roles keyed by UID."
    },
    "/userModeration/{targetUid}": {
      "schema": { "$ref": "#/entities/MemberModerationRecord" },
      "description": "Account restriction and suspension states managed by administrators."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ModerationReport" },
      "description": "Content and account abuse reports routed to the moderation queue."
    },
    "/appeals/{appealId}": {
      "schema": { "$ref": "#/entities/ModerationAppeal" },
      "description": "Member appeals of moderation decisions reviewed by administrators."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/PlatformAnnouncement" },
      "description": "Platform-wide governance banners and maintenance notices."
    },
    "/adminConfig/{configId}": {
      "schema": { "$ref": "#/entities/AdminConfigDoc" },
      "description": "Feature flags, moderation toggles, and community guidelines configuration."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Append-only audit trail for administrative actions."
    },
    "/accessInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/AccessInquiryRecord" },
      "description": "Landing and access inquiry approval queue managed by administrators."
    }
  }
}
