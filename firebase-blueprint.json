    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct or small-group real-time chat conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "isGroup": {
          "type": "boolean"
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded participant UIDs (max 10)"
        },
        "adminIds": {
          "type": "array",
          "description": "Group admin UIDs (max 10)"
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 400
        },
        "lastMessageSenderId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "isGroup",
        "memberIds",
        "lastMessageText",
        "lastMessageSenderId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a chat thread.",
