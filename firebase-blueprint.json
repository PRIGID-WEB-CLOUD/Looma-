    "CallRoom": {
      "title": "CallRoom",
      "description": "Real-time Cloudflare Calls WebRTC signaling room metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "callerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "callerAvatar": {
          "type": "string",
          "maxLength": 250000
        },
        "isAudioOnly": {
          "type": "boolean"
        },
