{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile information without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "bio": {
          "type": "string",
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "location": {
          "type": "string",
          "maxLength": 80
        },
        "interests": {
          "type": "array",
          "description": "Up to 8 interest topics"
        },
        "followersCount": {
          "type": "number"
        },
        "followingCount": {
          "type": "number"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "handle",
        "bio",
        "avatarUrl",
        "location",
        "interests",
        "followersCount",
        "followingCount",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateSettings": {
      "title": "UserPrivateSettings",
      "description": "Private user settings and PII isolated under user subcollection.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "pushEnabled": {
          "type": "boolean"
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "notifyLikes": {
          "type": "boolean"
        },
        "notifyComments": {
          "type": "boolean"
        },
        "notifyMessages": {
          "type": "boolean"
        },
        "profileVisibility": {
          "type": "string",
          "enum": ["public", "followers"]
        },
        "messagePrivacy": {
          "type": "string",
          "enum": ["everyone", "following"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "pushEnabled",
        "themePreference",
        "notifyLikes",
        "notifyComments",
        "notifyMessages",
        "profileVisibility",
        "messagePrivacy",
        "updatedAt"
      ]
    },
    "Post": {
      "title": "Post",
