        "authorHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "authorAvatar": {
          "type": "string",
          "maxLength": 250000
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 600000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "audioUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "linkUrl": {
          "type": "string",
          "maxLength": 1000
