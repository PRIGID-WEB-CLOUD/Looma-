        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "chatId",
        "title",
        "callerId",
        "callerName",
        "callerAvatar",
        "isAudioOnly",
        "status",
        "memberIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallPeerSession": {
      "title": "CallPeerSession",
      "description": "Per-participant Cloudflare Calls SFU session and track state inside a call room.",
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "cfSessionId": {
          "type": "string",
          "maxLength": 128
        },
        "audioTrackName": {
          "type": "string",
          "maxLength": 64
        },
        "videoTrackName": {
          "type": "string",
          "maxLength": 64
        },
        "isMuted": {
          "type": "boolean"
        },
        "isVideoOff": {
          "type": "boolean"
        },
        "isScreenSharing": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": ["joined", "declined", "left"]
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded participant UIDs matching parent call"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "callId",
        "uid",
        "displayName",
        "avatarUrl",
        "cfSessionId",
        "audioTrackName",
        "videoTrackName",
        "isMuted",
        "isVideoOff",
        "isScreenSharing",
        "state",
        "memberIds",
        "updatedAt"
      ]
    },
    "Hashtag": {
      "title": "Hashtag",
      "description": "Saved community hashtag created by an authenticated member.",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
