    "Bookmark": {
      "title": "Bookmark",
      "description": "User-saved post bookmark.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
